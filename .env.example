# Django Settings
# Kopiere diese Datei zu .env und fülle die Werte aus

# Security
SECRET_KEY=your-secret-key-here
DEBUG=True

# Allowed Hosts (kommagetrennt für Production)
ALLOWED_HOSTS=

# CORS Origins (kommagetrennt)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Database (für Production mit PostgreSQL)
# DATABASE_URL=postgres://user:password@localhost:5432/kanmind_db
